# Copy this file to ".env" and fill in your own values.
# .env is ignored by git, so your key stays on your machine.

# From the Azure portal: your AI Services resource -> Keys and Endpoint
AZURE_AI_KEY=your-key-here

# Both endpoints belong to the same resource
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_SERVICES_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_REGION=swedencentral

# The names of your two model deployments
AZURE_CHAT_DEPLOYMENT=gpt-5-mini
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-small
